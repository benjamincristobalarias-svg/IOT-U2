<?xml version="1.0" encoding="utf-8"?>
<!-- Solo conexiones cifradas: se bloquea el tráfico sin cifrar (HTTP).
     Firebase Authentication y Realtime Database usan HTTPS/TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
